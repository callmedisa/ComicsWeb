# Copy to backend/.env and fill in. Never commit the real .env.

# PostgreSQL (matches docker-compose.yml for local development)
DATABASE_URL=postgresql://comicspeak:<password>@localhost:5432/comicspeak

# Sign login tokens. Required in production; generate with: openssl rand -hex 32
JWT_SECRET=

PORT=3001
FRONTEND_ORIGIN=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:3001

# Code that lets a user sign up as a teacher (leave empty to disable)
TEACHER_SIGNUP_CODE=

# AI services
GROQ_API_KEY=
GROQ_MODEL=
GROQ_WHISPER_MODEL=
FAL_KEY=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
WHISPER_SERVICE_URL=http://localhost:8001
