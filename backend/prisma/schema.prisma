generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ArtStyle {
  Cartoon
  Comic
  Pixel
}

enum ComicLength {
  Short
  Medium
  Long
}

enum ComicStatus {
  generating
  done
  failed
}

enum CharacterType {
  Superhero
  Robot
  Animal
  Fantasy
  Historical
}

enum Role {
  STUDENT
  TEACHER
}

model User {
  id                    String      @id @default(cuid())
  name                  String      @unique
  password              String?
  role                  Role        @default(STUDENT)
  xp                    Int         @default(0)
  xpGoal                Int         @default(1000)
  gems                  Int         @default(0)
  streakDays            Int         @default(0)
  level                 Int         @default(1)
  cefrLevel             String      @default("A1")
  dailyChallengeDone    Int         @default(0)
  dailyChallengeGoal    Int         @default(5)
  dailyChallengeRewardXp Int        @default(50)
  lastActiveDate        DateTime?
  comics                Comic[]
  characters            Character[]
  speechAttempts        SpeechAttempt[]
  lessonProgress        UserLessonProgress[]
  createdAt             DateTime    @default(now())
}

model Comic {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  title       String
  genre       String      @default("")
  style       ArtStyle
  length      ComicLength
  status      ComicStatus @default(generating)
  progressPct Int         @default(0)
  panelsTotal Int
  panels      Panel[]
  createdAt   DateTime    @default(now())
}

model Panel {
  id         String         @id @default(cuid())
  comicId    String
  comic      Comic          @relation(fields: [comicId], references: [id])
  index      Int
  sceneLabel String
  imageUrl   String?
  dialogue   DialogueLine[]
}

model DialogueLine {
  id             String          @id @default(cuid())
  panelId        String
  panel          Panel           @relation(fields: [panelId], references: [id])
  speaker        String
  text           String
  order          Int
  speechAttempts SpeechAttempt[]
}

model Character {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id])
  type     CharacterType
  name     String
  traits   String[]
  color    String
  imageUrl String?
  level    Int           @default(1)
}

model SpeechAttempt {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  lineId     String
  line       DialogueLine @relation(fields: [lineId], references: [id])
  transcript String
  score      Int
  createdAt  DateTime     @default(now())
}

model TeacherProfile {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String
  photoUrl  String?
  createdAt DateTime @default(now())
}

model Course {
  id      String   @id @default(cuid())
  title   String
  level   String // "A1" | "A2" | "B1" | "B2"
  order   Int
  lessons Lesson[]

  @@unique([level, order])
}

model Lesson {
  id           String                @id @default(cuid())
  courseId     String
  course       Course                @relation(fields: [courseId], references: [id])
  title        String
  topic        String
  order        Int
  xpReward     Int                   @default(50)
  userProgress UserLessonProgress[]

  @@unique([courseId, order])
}

model UserLessonProgress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id])
  comicId     String?
  status      String    @default("locked") // "locked" | "available" | "completed"
  score       Int?
  completedAt DateTime?

  @@unique([userId, lessonId])
}
